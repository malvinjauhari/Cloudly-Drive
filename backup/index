  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-20 md:bottom-5 right-5 text-white px-4 py-3 rounded-lg shadow-lg opacity-0 pointer-events-none transition flex items-center space-x-2 z-[110]">
    <span id="toastMsg">Notifikasi</span>
  </div>

  <script>
    // ==========================================
    // STATE
    // ==========================================
    let appData = { files: [], workers: [], categories: [], totalQuota: 0, totalUsed: 0, totalFree: 0 };
    let appSettings = { maxFiles: 10, maxSizeMB: 50, categories: [] };
    let currentCategory = "";
    let selectedFilesToUpload = [];
    let fileToDelete = { fileId: null, googleFileId: null, workerId: null };
    let activeMainAccount = localStorage.getItem('unlidrive_main_account') || "ALL";
    let settingsUsers = [];
    let settingsWorkers = [];

    // ==========================================
    // AUTHENTICATION
    // ==========================================
    window.onload = () => {
      const user = JSON.parse(localStorage.getItem('unlidrive_user'));
      if (user && user.isLoggedIn) {
        document.getElementById('loginScreen').style.display = 'none';
        applyUserProfile(user.data);
        fetchData();
      }
    };

    function attemptLogin() {
      const u = document.getElementById('loginUser').value;
      const p = document.getElementById('loginPass').value;
      const btn = document.getElementById('btnLogin');
      btn.innerHTML = `<div class="loader w-5 h-5 border-white border-t-blue-200"></div>`;
      google.script.run.withSuccessHandler((res) => {
        if (res.status === 'success') {
          localStorage.setItem('unlidrive_user', JSON.stringify({ isLoggedIn: true, data: res.user }));
          applyUserProfile(res.user);
          document.getElementById('loginStep1').classList.add('hidden');
          document.getElementById('loginStep2').classList.remove('hidden');
          renderDriveSelection(res.drives);
        } else {
          btn.innerHTML = `<span>Login</span>`;
          showToast(res.message, true);
        }
      }).verifyLogin(u, p);
    }

    function renderDriveSelection(drives) {
      const list = document.getElementById('driveSelectionList');
      list.innerHTML = `<div onclick="selectMainAccount('ALL', 'Semua Akun')" class="p-4 border border-blue-200 bg-blue-50 rounded-xl cursor-pointer hover:bg-blue-100 transition"><h3 class="font-bold text-blue-800">Tampilkan Semua Drive</h3><p class="text-xs text-blue-600">Gabungkan semua file dari semua storage</p></div>`;
      drives.forEach(d => {
        list.innerHTML += `<div onclick="selectMainAccount('${d.id}', '${d.name}')" class="p-4 border border-gray-200 rounded-xl cursor-pointer hover:border-blue-400 hover:shadow-sm transition"><h3 class="font-bold text-gray-900">${d.name}</h3><p class="text-xs text-gray-500">${d.email} • Free: ${formatBytes(d.free_bytes)}</p></div>`;
      });
    }

    function selectMainAccount(id, name) {
      localStorage.setItem('unlidrive_main_account', id);
      localStorage.setItem('unlidrive_main_name', name);
      activeMainAccount = id;
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('activeAccountName').innerText = name;
      const mobileName = document.getElementById('activeAccountNameMobile');
      if(mobileName) mobileName.innerText = name;
      showToast("Berhasil masuk ke Dashboard");
      fetchData();
    }

    function switchMainAccount() {
      document.getElementById('loginScreen').style.display = 'flex';
      document.getElementById('loginStep1').classList.add('hidden');
      document.getElementById('loginStep2').classList.remove('hidden');
      renderDriveSelection(appData.workers);
    }

    function logout() {
      localStorage.removeItem('unlidrive_user');
      localStorage.removeItem('unlidrive_main_account');
      localStorage.removeItem('unlidrive_main_name');
      document.getElementById('loginScreen').style.display = 'flex';
      document.getElementById('loginStep2').classList.add('hidden');
      document.getElementById('loginStep1').classList.remove('hidden');
      document.getElementById('loginUser').value = '';
      document.getElementById('loginPass').value = '';
      document.getElementById('btnLogin').innerHTML = `<span>Login</span>`;
    }

    function applyUserProfile(userData) {
      document.getElementById('userNameDisplay').innerText = userData.name;
      document.getElementById('userEmailDisplay').innerText = userData.email;
      document.getElementById('userInitial').innerText = userData.name.charAt(0).toUpperCase();
      const savedName = localStorage.getItem('unlidrive_main_name');
      if(savedName) {
        document.getElementById('activeAccountName').innerText = savedName;
        const mobileName = document.getElementById('activeAccountNameMobile');
        if(mobileName) mobileName.innerText = savedName;
      }
    }

    // ==========================================
    // DATA FETCHING
    // ==========================================
    function fetchData() {
      google.script.run.withFailureHandler((err) => {
        document.getElementById('conn-status').className = 'text-xs px-2 py-1 bg-red-100 text-red-700 rounded-full font-medium';
        document.getElementById('conn-status').innerText = 'Error Connection';
        showToast("Gagal memuat data", true);
      }).withSuccessHandler((data) => {
        appData = data;
        document.getElementById('conn-status').className = 'text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full font-medium';
        document.getElementById('conn-status').innerText = 'Connected';
        renderCategories();
        populateUploadFilters();
        renderFiles();
        renderQuotaTracker();
        setupDragAndDrop();
      }).getAppData();
    }

    function fetchSettings() {
      google.script.run.withSuccessHandler((data) => {
        appSettings = data;
        document.getElementById('setMaxFiles').value = appSettings.maxFiles;
        document.getElementById('setMaxSizeMB').value = appSettings.maxSizeMB;
        renderSettingsCategories();
      }).getSettings();

      google.script.run.withSuccessHandler((users) => {
        settingsUsers = users;
        renderUsersTable();
      }).getUsers();

      google.script.run.withSuccessHandler((workers) => {
        settingsWorkers = workers;
        renderWorkersTable();
      }).getWorkers();
    }

    // ==========================================
    // UPLOAD FILTERS & CATEGORIES
    // ==========================================
    function populateUploadFilters() {
      const modalDrive = document.getElementById('modalDrive');
      modalDrive.innerHTML = '<option value="AUTO">Auto (Paling Kosong)</option>';
      appData.workers.forEach(w => {
        let sel = (activeMainAccount === w.id) ? "selected" : "";
        modalDrive.innerHTML += `<option value="${w.id}" ${sel}>${w.name} (${formatBytes(w.free_bytes)} free)</option>`;
      });
    }

    function renderCategories() {
      const grid = document.getElementById('categoryGrid');
      const selectModal = document.getElementById('modalCategory');
      grid.innerHTML = ''; selectModal.innerHTML = '';
      const colors = ['text-orange-500', 'text-yellow-500', 'text-green-500', 'text-blue-500', 'text-purple-500', 'text-pink-500'];
      appData.categories.forEach((cat, idx) => {
        const color = colors[idx % colors.length];
        grid.innerHTML += `<div onclick="filterCategory('${cat}')" class="cursor-pointer border border-gray-200 rounded-2xl p-5 flex flex-col items-center justify-center hover:shadow-md hover:border-blue-300 transition bg-white group"><svg class="w-12 h-12 ${color} mb-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"></path></svg><h3 class="font-semibold text-gray-800 text-sm truncate w-full text-center">${cat}</h3></div>`;
        selectModal.innerHTML += `<option value="${cat}">${cat}</option>`;
      });
      grid.innerHTML += `<div onclick="document.getElementById('addCategoryModal').classList.remove('hidden')" class="cursor-pointer border-2 border-dashed border-gray-300 rounded-2xl p-5 flex flex-col items-center justify-center hover:bg-gray-50 transition bg-white"><div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mb-2 text-gray-500"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg></div><h3 class="font-semibold text-gray-500 text-sm">Add Category</h3></div>`;
      selectModal.innerHTML += `<option value="Uncategorized">Uncategorized</option>`;
    }

    function filterCategory(cat) {
      currentCategory = cat;
      document.getElementById('activeFilterText').innerText = cat ? `Folder: ${cat}` : '';
      renderFiles();
    }

    // ==========================================
    // FILE TABLE
    // ==========================================
    function renderFiles() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const tbody = document.getElementById('fileTableBody');
      tbody.innerHTML = '';
      let filtered = appData.files.filter(f => {
        const fName = (f.file_name || "").toLowerCase();
        const matchSearch = fName.includes(search);
        const matchStorage = (activeMainAccount === 'ALL') || (f.worker_id === activeMainAccount);
        const matchCategory = currentCategory === "" || f.category === currentCategory;
        return matchSearch && matchStorage && matchCategory;
      });
      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-gray-400">Tidak ada file ditemukan.</td></tr>`;
        return;
      }
      filtered.forEach(f => {
        const workerName = appData.workers.find(w => w.id === f.worker_id)?.name || f.worker_id;
        let iconColor = "text-blue-500";
        if (f.mime_type.includes('image')) iconColor = "text-orange-500";
        else if (f.mime_type.includes('video')) iconColor = "text-purple-500";
        else if (f.mime_type.includes('pdf')) iconColor = "text-red-500";
        tbody.innerHTML += `<tr class="border-b border-gray-50 hover:bg-gray-50 transition group"><td class="p-4 min-w-[200px]"><div class="flex items-center space-x-3"><svg class="w-5 h-5 ${iconColor} flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path></svg><span class="font-medium text-gray-900 truncate block w-full max-w-xs" title="${f.file_name}">${f.file_name}</span></div></td><td class="p-4"><span class="px-2 py-1 bg-gray-100 rounded-md text-xs text-gray-600 font-medium whitespace-nowrap">${f.category}</span></td><td class="p-4 text-gray-500 text-xs whitespace-nowrap">${formatBytes(f.size_bytes)}</td><td class="p-4 text-gray-500 text-xs flex items-center space-x-2 whitespace-nowrap"><div class="w-4 h-4 rounded-full bg-blue-100 flex items-center justify-center text-[8px] text-blue-700">D</div><span class="truncate w-24">${workerName}</span></td><td class="p-4 text-center"><div class="flex justify-center space-x-2 opacity-100 md:opacity-0 group-hover:opacity-100 transition"><button onclick="openPreview('${f.google_file_id}', '${f.file_name}')" class="p-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-md" title="Preview"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg></button><button onclick="window.open('https://drive.google.com/uc?export=download&id=${f.google_file_id}', '_blank')" class="p-1.5 bg-gray-100 text-gray-600 hover:bg-gray-200 rounded-md" title="Download"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg></button><button onclick="confirmDelete('${f.file_id}', '${f.google_file_id}', '${f.worker_id}', '${f.file_name}')" class="p-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-md" title="Hapus Permanen"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg></button></div></td></tr>`;
      });
    }

    // ==========================================
    // DELETE LOGIC
    // ==========================================
    function confirmDelete(fileId, googleFileId, workerId, fileName) {
      fileToDelete = { fileId, googleFileId, workerId };
      document.getElementById('deleteFileName').innerText = fileName;
      document.getElementById('deleteModal').classList.remove('hidden');
    }

    function executeDelete() {
      const btn = document.getElementById('btnConfirmDelete');
      btn.innerHTML = `<div class="loader w-4 h-4 border-white border-t-red-200 mr-2"></div> Menghapus...`;
      btn.disabled = true;
      google.script.run.withSuccessHandler((res) => {
        if (res.status === 'success') { showToast(res.message); document.getElementById('deleteModal').classList.add('hidden'); fetchData(); }
        else { showToast(res.message, true); }
        btn.innerHTML = 'Hapus'; btn.disabled = false;
      }).processDeleteFile(fileToDelete.fileId, fileToDelete.googleFileId, fileToDelete.workerId);
    }

    // ==========================================
    // PREVIEW & CATEGORY MODAL
    // ==========================================
    function openPreview(fileId, fileName) {
      document.getElementById('previewTitle').innerText = fileName;
      document.getElementById('previewLoader').style.display = 'flex';
      document.getElementById('previewFrame').src = `https://drive.google.com/file/d/${fileId}/preview`;
      document.getElementById('previewModal').classList.remove('hidden');
    }
    function closePreview() { document.getElementById('previewModal').classList.add('hidden'); document.getElementById('previewFrame').src = ''; }

    function saveNewCategory() {
      const val = document.getElementById('newCategoryName').value;
      if(!val) return showToast("Nama kategori kosong!", true);
      document.getElementById('btnSaveCategory').innerHTML = "Menyimpan...";
      google.script.run.withSuccessHandler(res => {
        document.getElementById('addCategoryModal').classList.add('hidden');
        document.getElementById('newCategoryName').value = '';
        document.getElementById('btnSaveCategory').innerHTML = "Simpan";
        showToast(res.message); fetchData();
      }).addCategory(val);
    }

    // ==========================================
    // MULTI-FILE UPLOAD
    // ==========================================
    function setupDragAndDrop() {
      const overlay = document.getElementById('dragOverlay');
      const fileInput = document.getElementById('manualFileInput');
      fileInput.addEventListener('change', (e) => {
        if(e.target.files.length > 0) openUploadModal(Array.from(e.target.files));
        fileInput.value = '';
      });
      window.addEventListener('dragover', (e) => { e.preventDefault(); overlay.classList.remove('opacity-0', 'pointer-events-none'); });
      window.addEventListener('dragleave', (e) => { e.preventDefault(); if (e.clientX === 0 || e.clientY === 0) overlay.classList.add('opacity-0', 'pointer-events-none'); });
      window.addEventListener('drop', (e) => {
        e.preventDefault();
        overlay.classList.add('opacity-0', 'pointer-events-none');
        if(e.dataTransfer.files.length > 0) openUploadModal(Array.from(e.dataTransfer.files));
      });
    }

    function openUploadModal(files) {
      const maxFiles = appSettings.maxFiles || 10;
      const maxSizeBytes = (appSettings.maxSizeMB || 50) * 1024 * 1024;

      if (files.length > maxFiles) return showToast(`Maksimal ${maxFiles} file per upload.`, true);

      const oversized = files.filter(f => f.size > maxSizeBytes);
      if (oversized.length > 0) return showToast(`${oversized.length} file melebihi batas ${formatBytes(maxSizeBytes)}.`, true);

      selectedFilesToUpload = files;
      document.getElementById('uploadFileCount').textContent = files.length;
      const listEl = document.getElementById('uploadFileList');
      listEl.innerHTML = '';
      files.forEach(f => {
        listEl.innerHTML += `<div class="flex items-center justify-between py-1 px-2 bg-gray-50 rounded"><span class="truncate text-gray-700">${f.name}</span><span class="text-gray-400 text-xs ml-2">${formatBytes(f.size)}</span></div>`;
      });
      document.getElementById('uploadModal').classList.remove('hidden');
    }

    function closeUploadModal() {
      document.getElementById('uploadModal').classList.add('hidden');
      selectedFilesToUpload = [];
    }

    function startMultiUpload() {
      if (selectedFilesToUpload.length === 0) return;
      closeUploadModal();
      document.getElementById('uploadProgressModal').classList.remove('hidden');
      document.getElementById('btnCloseProgress').classList.add('hidden');
      document.getElementById('progressResults').classList.add('hidden');
      document.getElementById('progressResults').innerHTML = '';
      uploadQueue(selectedFilesToUpload, 0, []);
    }

    function uploadQueue(files, index, results) {
      if (index >= files.length) {
        document.getElementById('progressBar').style.width = '100%';
        document.getElementById('progressStatus').textContent = 'Selesai!';
        document.getElementById('btnCloseProgress').classList.remove('hidden');
        document.getElementById('progressResults').classList.remove('hidden');
        const successCount = results.filter(r => r.status === 'success').length;
        const failCount = results.filter(r => r.status === 'error').length;
        document.getElementById('progressStatus').textContent = `${successCount} berhasil, ${failCount} gagal`;
        fetchData();
        return;
      }

      const file = files[index];
      const total = files.length;
      const pct = Math.round(((index) / total) * 100);
      document.getElementById('progressBar').style.width = pct + '%';
      document.getElementById('progressFileName').textContent = file.name;
      document.getElementById('progressCount').textContent = `${index + 1}/${total}`;
      document.getElementById('progressStatus').textContent = 'Mengunggah...';

      const category = document.getElementById('modalCategory') ? document.getElementById('modalCategory').value : 'Uncategorized';
      let driveId = document.getElementById('modalDrive') ? document.getElementById('modalDrive').value : 'AUTO';
      const mode = driveId === 'AUTO' ? 'AUTO' : 'SPECIFIC';
      if(mode === 'AUTO') driveId = null;

      const reader = new FileReader();
      reader.onload = function(e) {
        const base64Data = e.target.result.split(',')[1];
        google.script.run.withSuccessHandler((res) => {
          results.push(res);
          uploadQueue(files, index + 1, results);
        }).withFailureHandler((err) => {
          results.push({ status: 'error', message: err.message || 'Unknown error' });
          uploadQueue(files, index + 1, results);
        }).processUploadFromWeb(file.name, file.type, base64Data, mode, driveId, category);
      };
      reader.readAsDataURL(file);
    }

    function closeProgressModal() {
      document.getElementById('uploadProgressModal').classList.add('hidden');
    }

    // ==========================================
    // QUOTA TRACKER
    // ==========================================
    function renderQuotaTracker() {
      document.getElementById('qt-total').innerText = formatBytes(appData.totalQuota);
      document.getElementById('qt-used').innerText = formatBytes(appData.totalUsed);
      document.getElementById('qt-free').innerText = formatBytes(appData.totalFree);
      document.getElementById('qt-accounts').innerText = appData.workers.length;
      const grid = document.getElementById('drivesGrid');
      grid.innerHTML = '';
      appData.workers.forEach(w => {
        const pct = w.quota_bytes === 0 ? 0 : (w.used_bytes / w.quota_bytes) * 100;
        let colorClass = pct > 80 ? 'bg-red-500' : (pct > 50 ? 'bg-yellow-500' : 'bg-green-500');
        grid.innerHTML += `<div class="border border-gray-200 rounded-xl p-6 bg-white"><div class="flex items-center space-x-3 mb-4"><div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M5.5 16a3.5 3.5 0 01-.369-6.98 4 4 0 117.753-1.977A4.5 4.5 0 1113.5 16h-8z"></path></svg></div><div><h4 class="font-bold text-gray-900">Google Drive</h4><p class="text-xs text-gray-500">${w.name} • ${w.email}</p></div></div><div class="flex justify-between text-xs text-gray-500 mb-1"><span><span class="inline-block w-2 h-2 rounded-full ${colorClass} mr-1"></span>storage</span><span>${Math.round(pct)}%</span></div><div class="w-full bg-gray-100 rounded-full h-1.5 mb-2"><div class="${colorClass} h-1.5 rounded-full" style="width: ${pct}%"></div></div><div class="flex justify-between text-xs text-gray-500"><span>${formatBytes(w.used_bytes)} / ${formatBytes(w.quota_bytes)}</span><span>Available ${formatBytes(w.free_bytes)}</span></div></div>`;
      });
    }

    // ==========================================
    // VIEW SWITCHING
    // ==========================================
    function switchView(view) {
      document.getElementById('view-files').classList.add('hidden');
      document.getElementById('view-quota').classList.add('hidden');
      document.getElementById('view-settings').classList.add('hidden');
      document.getElementById('nav-files').className = 'w-full flex items-center space-x-3 px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg font-medium transition';
      document.getElementById('nav-quota').className = 'w-full flex items-center space-x-3 px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg font-medium transition';
      document.getElementById('nav-settings').className = 'w-full flex items-center space-x-3 px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg font-medium transition';
      document.getElementById('nav-files-mobile').className = 'flex flex-col items-center p-2 text-gray-500';
      document.getElementById('nav-quota-mobile').className = 'flex flex-col items-center p-2 text-gray-500';
      document.getElementById('nav-settings-mobile').className = 'flex flex-col items-center p-2 text-gray-500';
      document.getElementById(`view-${view}`).classList.remove('hidden');
      document.getElementById(`nav-${view}`).className = 'w-full flex items-center space-x-3 px-3 py-2 bg-blue-50 text-blue-700 rounded-lg font-medium transition';
      document.getElementById(`nav-${view}-mobile`).className = 'flex flex-col items-center p-2 text-blue-600';
      if (view === 'settings') fetchSettings();
    }

    // ==========================================
    // SETTINGS: TAB SWITCHING
    // ==========================================
    function switchSettingsTab(tab) {
      document.getElementById('settingsTab-general').classList.add('hidden');
      document.getElementById('settingsTab-users').classList.add('hidden');
      document.getElementById('settingsTab-workers').classList.add('hidden');
      document.getElementById('stab-general').className = 'px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-900';
      document.getElementById('stab-users').className = 'px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-900';
      document.getElementById('stab-workers').className = 'px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-900';
      document.getElementById(`settingsTab-${tab}`).classList.remove('hidden');
      document.getElementById(`stab-${tab}`).className = 'px-4 py-2 text-sm font-medium rounded-md bg-white text-blue-700 shadow-sm';
    }

    // ==========================================
    // SETTINGS: GENERAL
    // ==========================================
    function renderSettingsCategories() {
      const container = document.getElementById('settingsCategoryList');
      container.innerHTML = '';
      (appSettings.categories || []).forEach(cat => {
        container.innerHTML += `<span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm flex items-center space-x-2"><span>${cat}</span><button onclick="removeSettingsCategory('${cat}')" class="text-blue-400 hover:text-red-500 ml-1">&times;</button></span>`;
      });
    }

    function addSettingsCategory() {
      const input = document.getElementById('settingsNewCategory');
      const val = input.value.trim();
      if (!val) return;
      if (!appSettings.categories) appSettings.categories = [];
      if (appSettings.categories.includes(val)) return showToast("Kategori sudah ada", true);
      appSettings.categories.push(val);
      input.value = '';
      renderSettingsCategories();
    }

    function removeSettingsCategory(cat) {
      appSettings.categories = appSettings.categories.filter(c => c !== cat);
      renderSettingsCategories();
    }

    function saveGeneralSettings() {
      const data = {
        maxFiles: parseInt(document.getElementById('setMaxFiles').value) || 10,
        maxSizeMB: parseInt(document.getElementById('setMaxSizeMB').value) || 50,
        categories: appSettings.categories || []
      };
      const btn = event.target;
      btn.textContent = 'Menyimpan...';
      btn.disabled = true;
      google.script.run.withSuccessHandler((res) => {
        showToast(res.message);
        btn.textContent = 'Simpan Pengaturan';
        btn.disabled = false;
        appSettings.maxFiles = data.maxFiles;
        appSettings.maxSizeMB = data.maxSizeMB;
      }).saveSettings(data);
    }

    // ==========================================
    // SETTINGS: USERS CRUD
    // ==========================================
    function renderUsersTable() {
      const tbody = document.getElementById('usersTableBody');
      if (settingsUsers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-gray-400">Belum ada user.</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      settingsUsers.forEach(u => {
        tbody.innerHTML += `<tr class="border-b border-gray-50"><td class="p-4 font-medium">${u.username}</td><td class="p-4">${u.name}</td><td class="p-4">${u.email}</td><td class="p-4"><span class="px-2 py-1 text-xs rounded-full ${u.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700'}">${u.role}</span></td><td class="p-4 text-center"><div class="flex justify-center space-x-2"><button onclick="editUser('${u.username}')" class="p-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-md text-xs">Edit</button><button onclick="deleteUser('${u.username}')" class="p-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-md text-xs">Hapus</button></div></td></tr>`;
      });
    }

    function openUserModal(editData) {
      document.getElementById('userModalTitle').textContent = editData ? 'Edit User' : 'Tambah User';
      document.getElementById('userEditOriginal').value = editData ? editData.username : '';
      document.getElementById('userUsername').value = editData ? editData.username : '';
      document.getElementById('userPassword').value = '';
      document.getElementById('userFullName').value = editData ? editData.name : '';
      document.getElementById('userEmail').value = editData ? editData.email : '';
      document.getElementById('userRole').value = editData ? editData.role : 'user';
      if (editData) document.getElementById('userUsername').disabled = true;
      else document.getElementById('userUsername').disabled = false;
      document.getElementById('userModal').classList.remove('hidden');
    }

    function closeUserModal() { document.getElementById('userModal').classList.add('hidden'); }

    function editUser(username) {
      const u = settingsUsers.find(u => u.username === username);
      if (u) openUserModal(u);
    }

    function saveUser() {
      const data = {
        username: document.getElementById('userUsername').value.trim(),
        password: document.getElementById('userPassword').value,
        name: document.getElementById('userFullName').value.trim(),
        email: document.getElementById('userEmail').value.trim(),
        role: document.getElementById('userRole').value
      };
      const original = document.getElementById('userEditOriginal').value;
      if (!data.username || !data.name) return showToast("Username dan Nama wajib diisi", true);
      if (!original && !data.password) return showToast("Password wajib diisi", true);

      const btn = document.getElementById('btnSaveUser');
      btn.textContent = 'Menyimpan...'; btn.disabled = true;
      google.script.run.withSuccessHandler((res) => {
        showToast(res.message);
        closeUserModal();
        fetchSettings();
        btn.textContent = 'Simpan'; btn.disabled = false;
      }).saveUser(original, data);
    }

    function deleteUser(username) {
      if (!confirm(`Hapus user "${username}"?`)) return;
      google.script.run.withSuccessHandler((res) => {
        showToast(res.message);
        fetchSettings();
      }).deleteUser(username);
    }

    // ==========================================
    // SETTINGS: WORKERS CRUD
    // ==========================================
    function renderWorkersTable() {
      const tbody = document.getElementById('workersTableBody');
      if (settingsWorkers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-gray-400">Belum ada worker.</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      settingsWorkers.forEach(w => {
        const statusColor = w.status === 'ONLINE' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700';
        tbody.innerHTML += `<tr class="border-b border-gray-50"><td class="p-4 font-mono text-xs">${w.id}</td><td class="p-4 font-medium">${w.name}</td><td class="p-4 text-sm">${w.email}</td><td class="p-4 text-xs text-gray-500 max-w-[200px] truncate" title="${w.url}">${w.url}</td><td class="p-4"><span class="px-2 py-1 text-xs rounded-full ${statusColor}">${w.status}</span></td><td class="p-4 text-center"><div class="flex justify-center space-x-2"><button onclick="editWorker('${w.id}')" class="p-1.5 bg-blue-50 text-blue-600 hover:bg-blue-100 rounded-md text-xs">Edit</button><button onclick="deleteWorker('${w.id}')" class="p-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-md text-xs">Hapus</button></div></td></tr>`;
      });
    }

    function openWorkerModal(editData) {
      document.getElementById('workerModalTitle').textContent = editData ? 'Edit Worker' : 'Tambah Worker';
      document.getElementById('workerEditOriginal').value = editData ? editData.id : '';
      document.getElementById('workerId').value = editData ? editData.id : '';
      document.getElementById('workerName').value = editData ? editData.name : '';
      document.getElementById('workerEmail').value = editData ? editData.email : '';
      document.getElementById('workerUrl').value = editData ? editData.url : '';
      document.getElementById('workerStatus').value = editData ? editData.status : 'ONLINE';
      if (editData) document.getElementById('workerId').disabled = true;
      else document.getElementById('workerId').disabled = false;
      document.getElementById('workerModal').classList.remove('hidden');
    }

    function closeWorkerModal() { document.getElementById('workerModal').classList.add('hidden'); }

    function editWorker(id) {
      const w = settingsWorkers.find(w => w.id === id);
      if (w) openWorkerModal(w);
    }

    function saveWorker() {
      const data = {
        id: document.getElementById('workerId').value.trim(),
        name: document.getElementById('workerName').value.trim(),
        email: document.getElementById('workerEmail').value.trim(),
        url: document.getElementById('workerUrl').value.trim(),
        status: document.getElementById('workerStatus').value
      };
      const original = document.getElementById('workerEditOriginal').value;
      if (!data.id || !data.name || !data.url) return showToast("ID, Name, dan URL wajib diisi", true);

      const btn = document.getElementById('btnSaveWorker');
      btn.textContent = 'Menyimpan...'; btn.disabled = true;
      google.script.run.withSuccessHandler((res) => {
        showToast(res.message);
        closeWorkerModal();
        fetchSettings();
        btn.textContent = 'Simpan'; btn.disabled = false;
      }).saveWorker(original, data);
    }

    function deleteWorker(id) {
      if (!confirm(`Hapus worker "${id}"?`)) return;
      google.script.run.withSuccessHandler((res) => {
        showToast(res.message);
        fetchSettings();
      }).deleteWorker(id);
    }

    // ==========================================
    // UTILITIES
    // ==========================================
    function showToast(msg, isError = false) {
      const toast = document.getElementById('toast');
      toast.innerHTML = isError ? `❌ ${msg}` : `✅ ${msg}`;
      toast.className = `fixed bottom-20 md:bottom-5 right-5 text-white px-4 py-3 rounded-lg shadow-lg opacity-100 transition flex items-center space-x-2 z-[110] ${isError ? 'bg-red-600' : 'bg-gray-900'}`;
      setTimeout(() => { toast.classList.replace('opacity-100', 'opacity-0'); }, 3500);
    }

    function formatBytes(bytes) {
      if (bytes === 0) return '0 B';
      const k = 1024, dm = 2, sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }
  </script>
</body>
