              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Max File Size (MB)</label>
                <input type="number" id="setMaxSizeMB" min="1" max="100000" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500" value="50">
              </div>
