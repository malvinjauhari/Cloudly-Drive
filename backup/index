            <div class="mt-6">
              <h3 class="font-bold text-gray-900 mb-4">Categories</h3>
              <div id="settingsCategoryList" class="flex flex-wrap gap-2 mb-3"></div>
              <div class="flex space-x-2">
                <input type="text" id="settingsNewCategory" class="flex-1 border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500 text-sm" placeholder="Tambah kategori baru...">
                <button onclick="addSettingsCategory()" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg text-sm font-medium">Tambah</button>
              </div>
