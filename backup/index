      <!-- VIEW: SETTINGS -->
      <div id="view-settings" class="hidden">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Settings</h2>
        <p class="text-gray-500 text-sm mb-6">Konfigurasi aplikasi, kelola user dan worker.</p>

        <!-- Settings Tabs -->
        <div class="flex space-x-1 bg-gray-100 rounded-lg p-1 mb-6 w-fit">
          <button onclick="switchSettingsTab('general')" id="stab-general" class="px-4 py-2 text-sm font-medium rounded-md bg-white text-blue-700 shadow-sm">General</button>
          <button onclick="switchSettingsTab('users')" id="stab-users" class="px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-900">Users</button>
          <button onclick="switchSettingsTab('workers')" id="stab-workers" class="px-4 py-2 text-sm font-medium rounded-md text-gray-600 hover:text-gray-900">Workers</button>
        </div>

        <!-- TAB: GENERAL -->
        <div id="settingsTab-general">
          <div class="bg-white border border-gray-200 rounded-xl p-6 max-w-xl">
            <h3 class="font-bold text-gray-900 mb-4">Upload Limits</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Max Files Per Upload</label>
                <input type="number" id="setMaxFiles" min="1" max="100" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500" value="10">
