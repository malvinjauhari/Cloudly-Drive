          <div class="p-5 border border-gray-200 rounded-xl bg-white"><p class="text-gray-500 text-sm mb-1">Used Storage</p><p class="text-2xl font-bold text-gray-900" id="qt-used">0 GB</p></div>
          <div class="p-5 border border-gray-200 rounded-xl bg-white"><p class="text-gray-500 text-sm mb-1">Available</p><p class="text-2xl font-bold text-gray-900" id="qt-free">0 GB</p></div>
          <div class="p-5 border border-gray-200 rounded-xl bg-white"><p class="text-gray-500 text-sm mb-1">Accounts</p><p class="text-2xl font-bold text-gray-900" id="qt-accounts">0</p></div>
