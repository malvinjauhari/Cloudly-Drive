<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>unlidriveapps</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #F8F9FA; }
    #dragOverlay { transition: opacity 0.2s ease-in-out; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    .loader { border: 3px solid #f3f3f3; border-top: 3px solid #2563eb; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  </style>
</head>
<body class="text-gray-800 h-screen overflow-hidden flex relative">

  <!-- LOGIN SCREEN OVERLAY -->
  <div id="loginScreen" class="fixed inset-0 bg-gray-50 z-[100] flex flex-col justify-center items-center p-4">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-sm border border-gray-100 flex flex-col max-h-[90vh]">
      <div id="loginStep1" class="flex flex-col w-full text-center">
        <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-md">
          <span class="text-white font-bold text-2xl">9</span>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-1">unlidriveapps</h2>
        <p class="text-sm text-gray-500 mb-6">Silakan login untuk melanjutkan</p>
        <div class="space-y-4 text-left">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
            <input type="text" id="loginUser" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Masukkan username">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
            <input type="password" id="loginPass" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" onkeyup="if(event.key === 'Enter') attemptLogin()">
          </div>
          <button id="btnLogin" onclick="attemptLogin()" class="w-full bg-blue-600 text-white font-semibold py-2.5 rounded-lg hover:bg-blue-700 transition flex justify-center items-center">
            <span>Login</span>
          </button>
        </div>
      </div>
      <div id="loginStep2" class="flex flex-col w-full hidden overflow-hidden">
        <h2 class="text-xl font-bold text-gray-900 mb-2 text-left">Pilih Akun Utama</h2>
        <p class="text-sm text-gray-500 mb-4 text-left">Pilih drive mana yang ingin Anda kelola pada sesi ini.</p>
        <div class="overflow-y-auto space-y-3 text-left pr-2 pb-2" id="driveSelectionList" style="max-height: 50vh;"></div>
        <button onclick="logout()" class="mt-4 w-full text-center text-sm font-medium text-red-500 hover:text-red-700">Batalkan Login</button>
      </div>
    </div>
  </div>

  <!-- DELETE CONFIRMATION MODAL -->
  <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 z-[70] hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-sm p-6 text-center">
      <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h3 class="text-lg font-bold text-gray-900 mb-2">Hapus Permanen?</h3>
      <p class="text-sm text-gray-500 mb-6">File <span id="deleteFileName" class="font-semibold text-gray-700"></span> akan dihapus dari Drive dan Database.</p>
      <div class="flex justify-center space-x-3">
        <button onclick="document.getElementById('deleteModal').classList.add('hidden')" class="px-5 py-2 text-gray-600 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
        <button id="btnConfirmDelete" onclick="executeDelete()" class="px-5 py-2 bg-red-600 text-white hover:bg-red-700 rounded-lg font-medium">Hapus</button>
      </div>
    </div>
  </div>

  <!-- FILE PREVIEW MODAL -->
  <div id="previewModal" class="fixed inset-0 bg-gray-900 bg-opacity-80 z-[60] hidden flex flex-col items-center justify-center p-4 backdrop-blur-sm">
    <div class="w-full max-w-5xl bg-white rounded-xl overflow-hidden shadow-2xl flex flex-col" style="height: 85vh;">
      <div class="flex justify-between items-center px-4 py-3 border-b border-gray-200 bg-gray-50">
        <h3 id="previewTitle" class="font-semibold text-gray-800 truncate">Preview File</h3>
        <button onclick="closePreview()" class="p-1 text-gray-500 hover:text-red-500 hover:bg-red-50 rounded-lg transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      <div class="flex-1 bg-gray-100 relative">
        <div id="previewLoader" class="absolute inset-0 flex flex-col items-center justify-center"><div class="loader mb-3"></div><p class="text-sm text-gray-500">Memuat preview...</p></div>
        <iframe id="previewFrame" class="w-full h-full relative z-10" onload="document.getElementById('previewLoader').style.display='none'" frameborder="0"></iframe>
      </div>
    </div>
  </div>

  <!-- ADD CATEGORY MODAL -->
  <div id="addCategoryModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-sm p-6">
      <h3 class="text-lg font-bold mb-4">Tambah Kategori Baru</h3>
      <input type="text" id="newCategoryName" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500 mb-4" placeholder="Misal: Laporan 2026">
      <div class="flex justify-end space-x-2">
        <button onclick="document.getElementById('addCategoryModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
        <button id="btnSaveCategory" onclick="saveNewCategory()" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium">Simpan</button>
      </div>
    </div>
  </div>

  <!-- MULTI-FILE UPLOAD MODAL -->
  <div id="uploadModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-lg p-6 max-h-[90vh] overflow-y-auto">
      <h3 class="text-lg font-bold mb-4">Upload Files</h3>
      <div class="mb-4">
        <p class="text-sm text-gray-500 mb-1"><span id="uploadFileCount">0</span> file terpilih:</p>
        <div id="uploadFileList" class="max-h-32 overflow-y-auto space-y-1 text-sm"></div>
      </div>
      <div class="space-y-3 mb-6">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Kategori / Folder</label>
          <select id="modalCategory" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Penyimpanan Target</label>
          <select id="modalDrive" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></select>
        </div>
      </div>
      <div class="flex justify-end space-x-2">
        <button onclick="closeUploadModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
        <button id="btnConfirmUpload" onclick="startMultiUpload()" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium">Upload</button>
      </div>
    </div>
  </div>

  <!-- UPLOAD PROGRESS MODAL -->
  <div id="uploadProgressModal" class="fixed inset-0 bg-black bg-opacity-50 z-[80] hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
      <h3 class="text-lg font-bold mb-4">Mengunggah File...</h3>
      <div class="mb-4">
        <div class="flex justify-between text-sm text-gray-600 mb-1">
          <span id="progressFileName">-</span>
          <span id="progressCount">0/0</span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2.5 mb-2">
          <div id="progressBar" class="bg-blue-600 h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
        <p id="progressStatus" class="text-xs text-gray-500">Menyiapkan...</p>
      </div>
      <div id="progressResults" class="max-h-40 overflow-y-auto space-y-1 text-sm mb-4 hidden"></div>
      <div class="flex justify-end">
        <button id="btnCloseProgress" onclick="closeProgressModal()" class="hidden px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium">Selesai</button>
      </div>
    </div>
  </div>

  <!-- SETTINGS: ADD/EDIT USER MODAL -->
  <div id="userModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
      <h3 id="userModalTitle" class="text-lg font-bold mb-4">Tambah User</h3>
      <input type="hidden" id="userEditOriginal">
      <div class="space-y-3 mb-6">
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Username</label><input type="text" id="userUsername" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Password</label><input type="password" id="userPassword" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label><input type="text" id="userFullName" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input type="email" id="userEmail" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Role</label><select id="userRole" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"><option value="admin">Admin</option><option value="user">User</option></select></div>
      </div>
      <div class="flex justify-end space-x-2">
        <button onclick="closeUserModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
        <button id="btnSaveUser" onclick="saveUser()" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium">Simpan</button>
      </div>
    </div>
  </div>

  <!-- SETTINGS: ADD/EDIT WORKER MODAL -->
  <div id="workerModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex justify-center items-center backdrop-blur-sm p-4">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
      <h3 id="workerModalTitle" class="text-lg font-bold mb-4">Tambah Worker</h3>
      <input type="hidden" id="workerEditOriginal">
      <div class="space-y-3 mb-6">
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Worker ID</label><input type="text" id="workerId" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Name</label><input type="text" id="workerName" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input type="email" id="workerEmail" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Web App URL</label><input type="url" id="workerUrl" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500" placeholder="https://script.google.com/macros/s/.../exec"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Status</label><select id="workerStatus" class="w-full border border-gray-300 rounded-lg px-3 py-2 outline-none focus:ring-1 focus:ring-blue-500"><option value="ONLINE">ONLINE</option><option value="OFFLINE">OFFLINE</option></select></div>
      </div>
      <div class="flex justify-end space-x-2">
        <button onclick="closeWorkerModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg font-medium">Batal</button>
        <button id="btnSaveWorker" onclick="saveWorker()" class="px-4 py-2 bg-blue-600 text-white hover:bg-blue-700 rounded-lg font-medium">Simpan</button>
      </div>
    </div>
  </div>

  <!-- DRAG OVERLAY -->
  <div id="dragOverlay" class="fixed inset-0 bg-blue-600 bg-opacity-90 z-[40] flex flex-col justify-center items-center opacity-0 pointer-events-none">
    <svg class="w-24 h-24 text-white mb-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
    <h2 class="text-3xl font-bold text-white">Lepaskan file untuk mengunggah</h2>
  </div>

  <!-- SIDEBAR -->
  <aside class="w-64 bg-white border-r border-gray-200 flex flex-col h-full relative z-10 hidden md:flex">
    <div class="p-6 flex items-center space-x-3">
      <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
        <span class="text-white font-bold text-lg">9</span>
      </div>
      <h1 class="text-xl font-bold text-gray-900 tracking-tight">unlidriveapps</h1>
    </div>
    <div class="px-6 pb-4">
      <div class="p-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:bg-gray-100 transition group" onclick="switchMainAccount()">
        <p class="text-xs text-gray-500 font-medium mb-1">Akun Utama Aktif:</p>
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2 truncate">
            <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M5.5 16a3.5 3.5 0 01-.369-6.98 4 4 0 117.753-1.977A4.5 4.5 0 1113.5 16h-8z"></path></svg>
            <p class="font-bold text-gray-900 text-sm truncate" id="activeAccountName">Semua Akun</p>
          </div>
          <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
        </div>
      </div>
    </div>
    <nav class="flex-1 px-4 space-y-1">
      <button onclick="switchView('files')" id="nav-files" class="w-full flex items-center space-x-3 px-3 py-2 bg-blue-50 text-blue-700 rounded-lg font-medium transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
        <span>All Files</span>
      </button>
      <button onclick="switchView('quota')" id="nav-quota" class="w-full flex items-center space-x-3 px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg font-medium transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
        <span>Quota Tracker</span>
      </button>
      <button onclick="switchView('settings')" id="nav-settings" class="w-full flex items-center space-x-3 px-3 py-2 text-gray-600 hover:bg-gray-50 rounded-lg font-medium transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        <span>Settings</span>
      </button>
    </nav>
    <div class="p-4 border-t border-gray-100">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center space-x-2 truncate">
          <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm flex-shrink-0" id="userInitial">A</div>
          <div class="text-xs truncate">
            <p class="font-bold text-gray-900 truncate" id="userNameDisplay">Admin</p>
            <p class="text-gray-500 truncate" id="userEmailDisplay">admin</p>
          </div>
        </div>
        <button onclick="logout()" class="text-gray-400 hover:text-red-500 transition ml-2 flex-shrink-0" title="Logout"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg></button>
      </div>
      <div class="text-center text-[10px] text-gray-400"><p>Author: Alvin Jauhari</p></div>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="flex-1 flex flex-col h-full bg-white relative w-full">
    <div class="md:hidden flex items-center justify-between p-4 border-b border-gray-100">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center"><span class="text-white font-bold text-lg">9</span></div>
        <h1 class="font-bold text-gray-900">unlidriveapps</h1>
      </div>
      <button onclick="logout()" class="text-red-500 text-sm font-medium">Logout</button>
    </div>

    <header class="h-auto md:h-20 p-4 md:px-8 flex flex-col md:flex-row items-center justify-between border-b border-gray-100 gap-4">
      <div class="w-full md:w-96 relative">
        <svg class="w-5 h-5 absolute left-3 top-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input type="text" id="searchInput" onkeyup="renderFiles()" placeholder="Cari file..." class="w-full pl-10 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-full text-sm focus:outline-none focus:border-blue-300 transition">
      </div>
      <div class="flex items-center justify-between w-full md:w-auto space-x-3">
        <span id="conn-status" class="text-xs px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full font-medium">Loading...</span>
        <input type="file" id="manualFileInput" class="hidden" multiple>
        <button onclick="document.getElementById('manualFileInput').click()" class="flex items-center space-x-2 bg-blue-50 text-blue-700 border border-blue-100 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
          <span>Upload</span>
        </button>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto p-4 md:p-8">
      <!-- VIEW: ALL FILES -->
      <div id="view-files">
        <div class="md:hidden mb-6 p-4 border border-blue-200 bg-blue-50 rounded-xl" onclick="switchMainAccount()">
          <p class="text-xs text-gray-500 font-medium">Akun Utama Aktif:</p>
          <div class="flex items-center justify-between">
            <span class="font-bold text-gray-900" id="activeAccountNameMobile">Semua Akun</span>
            <span class="text-xs text-blue-600 font-medium">Ubah</span>
          </div>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">File Explorer</h2>
        <div id="categoryGrid" class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8"></div>
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-4 gap-3">
          <div class="flex space-x-2">
            <button onclick="filterCategory('')" class="px-4 py-1.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-full hover:bg-gray-200 transition">All Categories</button>
            <input type="hidden" id="storageFilter" value="ALL">
          </div>
          <span id="activeFilterText" class="text-sm text-gray-500 font-medium"></span>
        </div>
        <div class="bg-white border border-gray-100 rounded-xl overflow-x-auto shadow-sm">
          <table class="w-full text-left border-collapse min-w-[600px]">
            <thead>
              <tr class="border-b border-gray-100 text-sm text-gray-500 bg-gray-50">
                <th class="p-4 font-semibold">Name</th>
                <th class="p-4 font-semibold">Category</th>
